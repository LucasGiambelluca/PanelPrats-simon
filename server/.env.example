# ---- Supabase (backend usa SERVICE ROLE: bypassa RLS) ----
# Dashboard Supabase → Project Settings → API
SUPABASE_URL=https://TUPROYECTO.supabase.co
SUPABASE_SERVICE_KEY=eyJ...service_role...   # NO la anon, NO la "sb_secret_". La JWT service_role.

# ---- Redis (checkpoints de sesión) ----
REDIS_URL=redis://127.0.0.1:6379

# ---- Baileys (auth de WhatsApp en filesystem, una carpeta por cuenta) ----
AUTH_BASE_PATH=./auth

# ---- IA (opcional; solo si usás nodos groq/intentResolver/aiAgent/audio) ----
GROQ_API_KEY=
GEMINI_API_KEY=

# ---- Server ----
PORT=3001
CORS_ORIGIN=http://localhost:5173
